{
  "manifest_version": 3,
  "name": "Wide Studio",
  "version": "0.10.0",
  "description": "Controles diretos, pontos persistentes e aparência simples para wide.video.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://integrate.api.nvidia.com/*",
    "https://drive.google.com/*",
    "https://drive.usercontent.google.com/*",
    "https://lh3.googleusercontent.com/*",
    "http://127.0.0.1/*",
    "https://snapinsta.ai/*",
    "https://d.rapidcdn.app/*",
    "https://api.fxtwitter.com/*",
    "https://video.twimg.com/*",
    "https://tubdown.com/*"
  ],
  "host_permissions": [
    "https://wide.video/*"
  ],
  "background": {
    "service_worker": "background/serviceWorker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Abrir Wide Studio",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://wide.video/*"
      ],
      "js": [
        "content/mainBridgeEntry.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://wide.video/*"
      ],
      "js": [
        "content/contentScript.js"
      ],
      "css": [
        "content/editor.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/mainBridgeEntry.js",
        "sidepanel.html",
        "assistant.html",
        "drive.html",
        "extract.html"
      ],
      "matches": [
        "https://wide.video/*"
      ]
    }
  ],
  "optional_permissions": [
    "nativeMessaging"
  ]
}
